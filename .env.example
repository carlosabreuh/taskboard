# Copy to .env.local for local dev. On Vercel, add these as Environment Variables.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: turns on smart add, plan my day and spreadsheet analysis (console.anthropic.com)
ANTHROPIC_API_KEY=
